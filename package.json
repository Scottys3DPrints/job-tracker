{
  "name": "job-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Internal job tracking tool for a small service business",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & node --watch dist/server.js",
    "seed": "node dist/seed.js",
    "test": "npm run build && node --test dist/api.test.js"
  },
  "dependencies": {
    "better-sqlite3": "11.7.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "typescript": "5.7.2"
  }
}
